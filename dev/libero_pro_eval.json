  "motion": {
    "position_scale": 0.05,
    "rotation_scale": 0.5,
    "position_gain": 1.0,
    "rotation_gain": 1.0,
    "position_tolerance_m": 0.005,
    "rotation_tolerance_rad": 0.05,
    "max_steps": 160,
    "gripper_max_opening_m": 0.08,
    "move_linear_steps": 80,
    "gripper_steps": 30,
    "follow_arc_steps": 100
