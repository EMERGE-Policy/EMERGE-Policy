      "mode": "existing",
      "width": 256,
      "height": 256,
      "depth": false,
      "flip_vertical": true
    },
    "robot0_eye_in_hand": {
      "mode": "existing",
      "width": 256,
      "height": 256,
      "depth": false,
      "flip_vertical": true
    },
    "perception_oblique_1": {
      "mode": "auto",
      "fovy": 62.0,
      "width": 518,
      "height": 518,
      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "reference": true,
        "directory": "artifacts/cameras/perception_oblique_1"
      }
    },
    "perception_oblique_2": {
      "mode": "auto",
      "fovy": 62.0,
      "width": 518,
      "height": 518,
      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "directory": "artifacts/cameras/perception_oblique_2"
      }
    },
    "perception_oblique_3": {
      "mode": "auto",
      "fovy": 62.0,
      "width": 518,
      "height": 518,
      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "directory": "artifacts/cameras/perception_oblique_3"
      }
    },
    "perception_side_1": {
      "mode": "auto",
      "fovy": 65.0,
      "width": 518,
      "height": 518,
      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "directory": "artifacts/cameras/perception_side_1"
      }
    },
    "perception_side_2": {
      "mode": "auto",
      "fovy": 65.0,
      "width": 518,
      "height": 518,
      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "directory": "artifacts/cameras/perception_side_2"
      }
    }
