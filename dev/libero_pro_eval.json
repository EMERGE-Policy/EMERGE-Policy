{
  "profile_path": "robot/profiles/libero_pro_mujoco.md",
  "libero": {
    "libero_source_path": "third_party/libero_pro",
    "libero_data_path": "third_party/libero_pro_data",
    "libero_environment_cache_path": "artifacts/libero_pro_eval_generated",
    "mujoco_gl": "egl",
    "disable_numba_jit": true,
    "robots": [
