      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "directory": "artifacts/cameras/perception_oblique_2"
      }
    },
    "perception_oblique_3": {
      "mode": "auto",
      "fovy": 62.0,
      "width": 518,
      "height": 518,
      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "directory": "artifacts/cameras/perception_oblique_3"
      }
    },
    "perception_side_1": {
      "mode": "auto",
      "fovy": 65.0,
      "width": 518,
