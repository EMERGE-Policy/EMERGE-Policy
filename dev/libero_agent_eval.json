      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "directory": "artifacts/cameras/perception_side_1"
      }
    },
    "perception_side_2": {
      "mode": "auto",
      "fovy": 65.0,
      "width": 518,
      "height": 518,
      "depth": false,
      "flip_vertical": true,
      "observation": {
        "enabled": true,
        "directory": "artifacts/cameras/perception_side_2"
      }
